<Application x:Class="DianGeJi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DianGeJi"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:UrlToImageConverter x:Key="UrlToImage" />
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
            <local:PageToVisibilityConverter x:Key="PageToVis" />
            <local:BotStateToBrushConverter x:Key="BotStateToBrush" />
            <local:PlayIconConverter x:Key="PlayIcon" />
            <local:VolumeIconConverter x:Key="VolumeIcon" />

            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>

            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,18,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- 左侧导航按钮 -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="5" Padding="12,9" Background="Transparent">
                                <Grid>
                                    <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                            Margin="-12,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                    <ContentPresenter />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 歌曲行的封面 -->
            <DataTemplate x:Key="Thumb">
                <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,40,40" RadiusX="4" RadiusY="4" />
                    </Border.Clip>
                    <Image Source="{Binding Thumb, Converter={StaticResource UrlToImage}, ConverterParameter=96}" Stretch="UniformToFill" />
                </Border>
            </DataTemplate>

            <!-- 列表行里悬停才显示的小按钮 -->
            <Style x:Key="RowButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="7" />
                <Setter Property="Margin" Value="2,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
