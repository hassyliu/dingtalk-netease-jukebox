<ui:FluentWindow x:Class="DianGeJi.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:DianGeJi"
                 Title="点歌机" Width="1160" Height="780" MinWidth="900" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="点歌机">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <DockPanel Grid.Column="0" Margin="8,4,8,10">
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- 网易云账号 -->
                    <Border Padding="10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <ui:SymbolIcon Symbol="Person24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Ellipse Visibility="{Binding AccountAvatar, Converter={StaticResource NotEmptyToVis}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding AccountAvatar, Converter={StaticResource UrlToImage}, ConverterParameter=80}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                    <Border Background="#D6342C" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="VIP" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Secondary}" Text="网易云音乐"
                                           Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                                <ui:HyperlinkButton Content="扫码登录" Padding="0" Command="{Binding LoginCommand}"
                                                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=!}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- 钉钉状态 -->
                    <Border Padding="10,8" CornerRadius="6" Cursor="Hand" ToolTip="{Binding BotStatus}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            MouseLeftButtonUp="BotStatus_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding BotState, Converter={StaticResource BotStateToBrush}}" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center">
                                <Run Text="钉钉：" /><Run Text="{Binding BotStatusShort}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox x:Name="Nav" SelectedIndex="{Binding PageIndex}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                        <TextBlock Text="播放列表" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Search24" />
                        <TextBlock Text="搜索点歌" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Library24" />
                        <TextBlock Text="歌单" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="History24" />
                        <TextBlock Text="最近播放" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" />
                        <TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBox>
            </DockPanel>

            <!-- 右侧内容 -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,16,28,0">
                        <ui:InfoBar Title="钉钉机器人还没配置" Severity="Warning" IsClosable="False"
                                    Message="到左侧「设置」里填好 Client ID 和 Client Secret，群里就能 @机器人 点歌了。"
                                    IsOpen="{Binding ShowSetupBar}">
                            <ui:Button Content="去设置" Command="{Binding GoSettingsCommand}" Margin="0,0,0,4" />
                        </ui:InfoBar>
                        <ui:InfoBar Title="钉钉连接失败" Severity="Error" IsClosable="False"
                                    Message="{Binding BotStatus}" IsOpen="{Binding ShowBotErrorBar}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:Button Content="检查设置" Command="{Binding GoSettingsCommand}" />
                                <ui:Button Content="重新连接" Command="{Binding ReconnectCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </ui:InfoBar>
                    </StackPanel>

                    <!-- ======== 页面 0：播放列表 ======== -->
                    <DockPanel Grid.Row="1" Margin="28,12,28,0" Visibility="{Binding PageIndex, Converter={StaticResource PageToVis}, ConverterParameter=0}">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="播放列表" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="{Binding QueueCountText}" Style="{StaticResource Secondary}" FontSize="14" Margin="12,0,0,5" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="清空" Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding ClearQueueCommand}" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Secondary}" Margin="2,6,0,10"
                                   Text="拖动可以调整顺序；鼠标移到歌曲上可以置顶、上移、下移、删除。" />
                        <Grid>
                            <ui:ListView x:Name="QueueList" ItemsSource="{Binding Queue}" AllowDrop="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseLeftButtonDown="Queue_PreviewMouseDown" PreviewMouseMove="Queue_PreviewMouseMove"
                                      DragOver="Queue_DragOver" Drop="Queue_Drop"
                                      Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=!}">
                                <ui:ListView.ItemContainerStyle>
                                    <Style TargetType="{x:Type ui:ListViewItem}" BasedOn="{StaticResource ListViewItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ui:ListView.ItemContainerStyle>
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Song}">
                                        <Grid Height="54">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Index}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <ContentPresenter Grid.Column="1" ContentTemplate="{StaticResource Thumb}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border BorderBrush="#D6342C" BorderThickness="1" CornerRadius="3" Padding="3,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="VIP" Foreground="#D6342C" FontSize="10" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding RequesterText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="8,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}, Converter={StaticResource BoolToVis}}">
                                                <ui:Button Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon ArrowUpload24}" ToolTip="置顶（下一首播放）"
                                                           Command="{Binding DataContext.TopCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                                <ui:Button Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="上移"
                                                           Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                                <ui:Button Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon ArrowDown24}" ToolTip="下移"
                                                           Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                                <ui:Button Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="删除"
                                                           Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                            </ui:ListView>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"
                                        Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="MusicNote224" FontSize="56" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="列表是空的" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Text="{Binding QueueEmptyHint}" Style="{StaticResource Secondary}" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <!-- ======== 页面 1：搜索点歌 ======== -->
                    <DockPanel Grid.Row="1" Margin="28,12,28,0" Visibility="{Binding PageIndex, Converter={StaticResource PageToVis}, ConverterParameter=1}">
                        <TextBlock DockPanel.Dock="Top" Text="搜索点歌" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="歌名 / 歌手 / 网易云分享链接" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <ui:Button Grid.Column="1" Content="搜索" Appearance="Primary" Margin="8,0,0,0" MinWidth="80"
                                       Command="{Binding SearchCommand}" />
                        </Grid>
                        <Grid>
                            <ui:ListView ItemsSource="{Binding SearchResults}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ui:ListView.ItemContainerStyle>
                                    <Style TargetType="{x:Type ui:ListViewItem}" BasedOn="{StaticResource ListViewItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ui:ListView.ItemContainerStyle>
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Song}">
                                        <Grid Height="54">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter ContentTemplate="{StaticResource Thumb}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border BorderBrush="#D6342C" BorderThickness="1" CornerRadius="3" Padding="3,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="VIP" Foreground="#D6342C" FontSize="10" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Content="插队" ToolTip="排到下一首" Icon="{ui:SymbolIcon ArrowUpload24}"
                                                           Command="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                                <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Margin="6,0,0,0"
                                                           Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                            </ui:ListView>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60"
                                        Visibility="{Binding SearchHint, Converter={StaticResource NotEmptyToVis}}">
                                <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" Margin="0,0,0,12"
                                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon Symbol="Search24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}, ConverterParameter=!}" />
                                <TextBlock Text="{Binding SearchHint}" Style="{StaticResource Secondary}" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <!-- ======== 页面 2：歌单 ======== -->
                    <ScrollViewer Grid.Row="1" Visibility="{Binding PageIndex, Converter={StaticResource PageToVis}, ConverterParameter=2}">
                        <StackPanel Margin="28,12,28,24">
                            <TextBlock Text="歌单" Style="{StaticResource PageTitle}" />

                            <TextBlock Text="导入网易云歌单" Style="{StaticResource SectionTitle}" />
                            <ui:Card>
                                <StackPanel>
                                    <ui:TextBox Text="{Binding PlaylistInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="粘贴歌单链接或输入歌单 ID"
                                                Icon="{ui:SymbolIcon Link24}" ClearButtonEnabled="True" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <ui:Button Content="导入到播放列表" Appearance="Primary" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportPlaylistCommand}" />
                                        <ui:ToggleSwitch Content="打乱顺序" IsChecked="{Binding ShuffleImport}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        <ui:Button Content="设为空闲歌单" Icon="{ui:SymbolIcon ArrowShuffle24}" Command="{Binding SetIdleCommand}" Margin="20,0,0,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </ui:Card>

                            <TextBlock Text="空闲歌单" Style="{StaticResource SectionTitle}" />
                            <ui:CardControl>
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="ArrowShuffle24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding IdleText}" FontWeight="SemiBold" />
                                        <TextBlock Text="播放列表空了的时候，从这个歌单里随机挑歌播放" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="关闭" Command="{Binding IdleOffCommand}" Visibility="{Binding HasIdle, Converter={StaticResource BoolToVis}}" />
                            </ui:CardControl>

                            <Grid Margin="0,0,0,0">
                                <TextBlock Text="我的歌单" Style="{StaticResource SectionTitle}" />
                                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" Appearance="Transparent"
                                           Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="刷新" Command="{Binding LoadMyPlaylistsCommand}"
                                           Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <ui:Card Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=!}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="登录网易云后，这里会列出你创建和收藏的歌单。" VerticalAlignment="Center" />
                                    <ui:Button Content="扫码登录" Margin="12,0,0,0" Command="{Binding LoginCommand}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" Margin="4,8"
                                             Visibility="{Binding IsLoadingPlaylists, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding MyPlaylists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Playlist}">
                                        <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="6"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter ContentTemplate="{StaticResource Thumb}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Secondary}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Content="导入" Icon="{ui:SymbolIcon ArrowImport24}"
                                                               Command="{Binding DataContext.ImportMyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <ui:Button Content="设为空闲歌单" Margin="6,0,0,0"
                                                               Command="{Binding DataContext.IdleMyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======== 页面 3：最近播放 & 动态 ======== -->
                    <Grid Grid.Row="1" Margin="28,12,28,16" Visibility="{Binding PageIndex, Converter={StaticResource PageToVis}, ConverterParameter=3}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最近播放" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />
                        <TextBlock Grid.Column="2" Text="动态" Style="{StaticResource SectionTitle}" VerticalAlignment="Bottom" Margin="2,0,0,14" />
                        <Grid Grid.Row="1">
                            <ui:ListView ItemsSource="{Binding History}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ui:ListView.ItemContainerStyle>
                                    <Style TargetType="{x:Type ui:ListViewItem}" BasedOn="{StaticResource ListViewItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ui:ListView.ItemContainerStyle>
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Song}">
                                        <Grid Height="54">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter ContentTemplate="{StaticResource Thumb}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Secondary}">
                                                    <Run Text="{Binding Artists, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RequesterText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <ui:Button Grid.Column="2" Style="{StaticResource RowButton}" Icon="{ui:SymbolIcon Add24}" ToolTip="再点一次"
                                                       Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                            </ui:ListView>
                            <TextBlock Text="还没有播放过歌曲" Style="{StaticResource Secondary}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding History.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=!}" />
                        </Grid>
                        <Border Grid.Row="1" Grid.Column="2" CornerRadius="6" Padding="14,10"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:EventItem}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding T}" Style="{StaticResource Secondary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ======== 页面 4：设置 ======== -->
                    <ScrollViewer Grid.Row="1" Visibility="{Binding PageIndex, Converter={StaticResource PageToVis}, ConverterParameter=4}">
                        <StackPanel Margin="28,12,28,28" MaxWidth="1000" HorizontalAlignment="Stretch">
                            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />

                            <TextBlock Text="网易云音乐" Style="{StaticResource SectionTitle}" />
                            <ui:CardControl Margin="0,0,0,4">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="Person24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AccountDetail}" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <Grid>
                                    <ui:Button Content="扫码登录" Appearance="Primary" Icon="{ui:SymbolIcon QrCode24}" Command="{Binding LoginCommand}"
                                               Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=!}" />
                                    <ui:Button Content="退出登录" Icon="{ui:SymbolIcon SignOut24}" Command="{Binding LogoutCommand}"
                                               Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </ui:CardControl>
                            <ui:CardControl>
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="MusicNote224" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="音质" FontWeight="SemiBold" />
                                        <TextBlock Text="音质越高文件越大；无损（FLAC）需要 VIP 账号" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox ItemsSource="{Binding Qualities}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedQuality}" MinWidth="160" />
                            </ui:CardControl>

                            <TextBlock Text="钉钉机器人" Style="{StaticResource SectionTitle}" />
                            <ui:Card>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Client ID" VerticalAlignment="Center" />
                                        <ui:TextBox Grid.Column="1" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="dingxxxxxxxxxxxx" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Text="Client Secret" VerticalAlignment="Center" />
                                        <ui:PasswordBox Grid.Row="1" Grid.Column="1" Password="{Binding ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="{Binding SecretPlaceholder}" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="2" Text="连接状态" VerticalAlignment="Center" />
                                        <Grid Grid.Row="2" Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,130,0">
                                                <Ellipse Width="8" Height="8" Fill="{Binding BotState, Converter={StaticResource BotStateToBrush}}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding BotStatus}" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ui:Button HorizontalAlignment="Right" Content="保存并连接" Appearance="Primary" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding ReconnectCommand}" />
                                        </Grid>
                                    </Grid>
                                    <Expander Margin="0,14,0,0" Header="怎么获取 Client ID 和 Client Secret？">
                                        <StackPanel Margin="4,4,0,0">
                                            <TextBlock TextWrapping="Wrap" LineHeight="24">
                                                1. 用管理员账号打开钉钉开发者后台，创建一个企业内部应用<LineBreak />
                                                2. 添加应用能力 →「机器人」，消息接收模式选择 <Bold>Stream 模式</Bold>，保存<LineBreak />
                                                3. 在「凭证与基础信息」里复制 Client ID 和 Client Secret，填到上面<LineBreak />
                                                4. 在「版本管理与发布」里发布应用<LineBreak />
                                                5. 打开钉钉群 → 群设置 → 机器人 → 添加机器人，搜索并添加这个机器人
                                            </TextBlock>
                                            <ui:HyperlinkButton Content="打开钉钉开发者后台" Command="{Binding OpenDevPortalCommand}" Margin="-10,6,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ui:Card>

                            <TextBlock Text="点歌规则" Style="{StaticResource SectionTitle}" />
                            <ui:CardControl Margin="0,0,0,4">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="Person24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="管理员" FontWeight="SemiBold" />
                                        <TextBlock Text="钉钉昵称，多个用逗号分隔；留空表示所有人都是管理员。管理员可以置顶、清空、调音量、删别人的歌" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:TextBox Text="{Binding Admins, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如：张三，李四" Width="260" />
                            </ui:CardControl>
                            <ui:CardControl Margin="0,0,0,4">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="每人最多点几首" FontWeight="SemiBold" />
                                        <TextBlock Text="同一个人在列表里最多同时排几首，0 表示不限制" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:NumberBox Value="{Binding MaxSongs}" Minimum="0" Maximum="99" MaxDecimalPlaces="0" SmallChange="1" Width="130" />
                            </ui:CardControl>
                            <ui:CardControl Margin="0,0,0,4">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="Timer24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="拒绝只能试听的歌" FontWeight="SemiBold" />
                                        <TextBlock Text="没登录 VIP 或需要单独购买的歌只能放 30 秒，点歌时直接拒绝" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding SkipTrial}" />
                            </ui:CardControl>
                            <ui:CardControl>
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="ArrowShuffle24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="有人点歌时立刻打断空闲歌单" FontWeight="SemiBold" />
                                        <TextBlock Text="关闭时会等正在放的随机歌曲放完" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding IdleInterrupt}" />
                            </ui:CardControl>

                            <TextBlock Text="窗口" Style="{StaticResource SectionTitle}" />
                            <ui:CardControl>
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="Window24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="关闭窗口时最小化到托盘" FontWeight="SemiBold" />
                                        <TextBlock Text="音乐继续播放；右键托盘图标选「退出点歌机」才会真正退出" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
                            </ui:CardControl>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <ui:Button Content="保存设置" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" MinWidth="120" Command="{Binding SaveSettingsCommand}" />
                            </StackPanel>

                            <TextBlock Text="其他" Style="{StaticResource SectionTitle}" />
                            <ui:CardControl Margin="0,0,0,4">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="Folder24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="设置文件夹" FontWeight="SemiBold" />
                                        <TextBlock Text="%APPDATA%\点歌机：设置、播放列表、加密保存的登录凭证" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="打开" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenDataFolderCommand}" />
                            </ui:CardControl>
                            <ui:CardControl>
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="DocumentText24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="运行日志" FontWeight="SemiBold" />
                                        <TextBlock Text="出问题时可以把日志发给开发者排查" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="打开" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogFolderCommand}" />
                            </ui:CardControl>
                        </StackPanel>
                    </ScrollViewer>

                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 底部播放栏 ============ -->
        <Border Grid.Row="2" Height="96" BorderThickness="0,1,0,0" Padding="16,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="2*" MaxWidth="560" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!-- 歌曲信息 -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,64,64" RadiusX="6" RadiusY="6" />
                        </Border.Clip>
                        <Grid>
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="26" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Image Source="{Binding CoverUrl, Converter={StaticResource UrlToImage}, ConverterParameter=200}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" Margin="0,1,0,0" ToolTip="{Binding Subtitle}" />
                        <TextBlock Text="{Binding RequesterText}" FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Visibility="{Binding RequesterText, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                </Grid>

                <!-- 播放控制 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Width="44" Height="44" CornerRadius="22" Padding="0" Appearance="Primary" ToolTip="播放 / 暂停"
                                   Command="{Binding TogglePlayCommand}">
                            <ui:SymbolIcon Symbol="{Binding IsPaused, Converter={StaticResource PlayIcon}}" Filled="True" FontSize="20" />
                        </ui:Button>
                        <ui:Button Width="40" Height="40" CornerRadius="20" Padding="0" Margin="12,0,0,0" Appearance="Transparent" ToolTip="切歌"
                                   Command="{Binding NextCommand}">
                            <ui:SymbolIcon Symbol="Next24" Filled="True" FontSize="20" />
                        </ui:Button>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="{Binding Duration}"
                                Value="{Binding Position, Mode=TwoWay}" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                IsEnabled="{Binding HasCurrent}"
                                PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseLeftButtonUp="Seek_MouseUp" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- 音量 & 输出设备 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:SymbolIcon Symbol="{Binding Volume, Converter={StaticResource VolumeIcon}}" FontSize="18" VerticalAlignment="Center" />
                        <Slider Width="130" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" Margin="8,0" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" />
                        <TextBlock Text="{Binding Volume}" Width="24" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:SymbolIcon Symbol="Headphones24" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="输出设备" />
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="230" ToolTip="输出设备" />
                        <ui:Button Appearance="Transparent" Padding="6" Margin="4,0,0,0" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   ToolTip="重新扫描设备（插了新耳机/音箱后点一下）" Command="{Binding RefreshDevicesCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlayerError}" Foreground="#D13438" FontSize="11.5" HorizontalAlignment="Right" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="320" ToolTip="{Binding PlayerError}"
                               Visibility="{Binding PlayerError, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 启动中 / 启动失败 ============ -->
        <Grid x:Name="StartupOverlay" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource ApplicationBackgroundBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <Image Source="pack://application:,,,/Assets/app.png" Width="64" Height="64" Margin="0,0,0,18" />
                <ui:ProgressRing x:Name="StartupRing" IsIndeterminate="True" Width="32" Height="32" Margin="0,0,0,14" />
                <TextBlock x:Name="StartupText" Text="正在启动…" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel x:Name="StartupActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed">
                    <ui:Button Content="重试" Appearance="Primary" Click="Retry_Click" MinWidth="90" />
                    <ui:Button Content="打开日志文件夹" Click="OpenLogs_Click" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
