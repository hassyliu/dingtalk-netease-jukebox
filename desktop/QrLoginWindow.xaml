<ui:FluentWindow x:Class="DianGeJi.QrLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="网易云扫码登录" Width="380" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 FontFamily="{StaticResource UiFont}">
    <StackPanel>
        <ui:TitleBar Title="网易云扫码登录" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="28,8,28,24">
            <Border Width="236" Height="236" CornerRadius="10" Background="White" Padding="8" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <ui:ProgressRing x:Name="Ring" IsIndeterminate="True" Width="36" Height="36" />
                    <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>
            </Border>
            <TextBlock x:Name="StatusText" Text="正在获取二维码…" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
            <TextBlock Text="打开网易云音乐 App → 左上角菜单 → 扫一扫" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <ui:Button x:Name="RefreshButton" Content="刷新二维码" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="Refresh_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                <ui:Button Content="取消" Click="Cancel_Click" MinWidth="90" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
